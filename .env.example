# Copy the names to Railway > your app service > Variables. Do not put real values in this file.

# Railway: use the reference to the Postgres service
DATABASE_URL=${{Postgres.DATABASE_URL}}

# The shared password for adding and changing scores (choose your own)
EDIT_PASSWORD=

# A long random string that signs the login cookie
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Railway sets PORT itself.
# PORT=3000
# Optional. Only for a public database URL that needs SSL.
# DATABASE_SSL=true
